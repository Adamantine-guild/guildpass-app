# GuildPass — Environment Variables
# Copy this file to apps/dashboard/.env.local (or the appropriate location)
# and fill in your values. NEVER commit .env files to source control.

# ═══════════════════════════════════════════════════════════════════════════════
# DASHBOARD (Primary App)
# ═══════════════════════════════════════════════════════════════════════════════

# API mode: "mock" (default, no external services) or "live" (connects to core API)
# DASHBOARD_API_MODE=mock

# Storage mode: "mock" (default, in-memory) or "durable" (database-backed)
# DASHBOARD_STORAGE_MODE=mock

# Activity delivery fallback interval in milliseconds (default: 15000 = 15 s).
# Set to 0 to disable automatic SSE and polling while retaining manual refresh.
NEXT_PUBLIC_ACTIVITY_REFRESH_MS=15000

# Webhook activity idempotency storage.
# Use `memory` for local mock dashboards.
# Use `file` to persist webhook IDs across local restarts.
# Use `durable` for multi-instance-safe idempotency backed by PostgreSQL.
# The durable mode lazily expires processed webhook IDs after a 7-day TTL.
ACTIVITY_STORAGE_MODE=memory
ACTIVITY_STORAGE_DIR=.guildpass-activity

# ── GuildPass Core API (required in live mode) ────────────────────────────────
# Base URL of the running guildpass-core access-api
GUILD_PASS_CORE_URL=http://localhost:3000

# Optional API key if core is running with auth enabled
GUILD_PASS_CORE_API_KEY=

# Incoming GuildPass webhook secret (for verifying x-guildpass-signature headers)
WEBHOOK_SECRET=

# ── Outbound Webhook Delivery (packages/webhook-utils dispatchWebhook) ─────────
# Secret used to sign outbound webhooks sent to subscriber URLs. Distinct from
# WEBHOOK_SECRET above (which verifies inbound webhooks). Subscribers verify
# deliveries with this same secret via verifySignature.
WEBHOOK_DISPATCH_SECRET=

# Mock subscriber registry: JSON object mapping guildId to subscriber URL(s),
# e.g. {"guild_123":"https://example.com/hooks/guildpass"}. A guildId may map
# to a single URL string or an array of URL strings.
WEBHOOK_SUBSCRIBERS=

# Delivery retry tuning (optional; see packages/webhook-utils/README.md).
# Defaults: 3 attempts, 200ms base delay, 10000ms max delay, exponential
# backoff with full jitter.
WEBHOOK_DISPATCH_MAX_ATTEMPTS=
WEBHOOK_DISPATCH_BASE_DELAY_MS=
WEBHOOK_DISPATCH_MAX_DELAY_MS=

# ── Database (required when DASHBOARD_STORAGE_MODE=durable) ────────────────────
# Run migrations using 'pnpm db:migrate' after configuring DATABASE_URL.
# Optionally, seed initial fixture data with 'pnpm db:seed'.
DATABASE_URL=postgresql://guildpass:guildpass_dev@localhost:5432/guildpass?schema=public

# ═══════════════════════════════════════════════════════════════════════════════
# DISCORD BOT (Legacy / Optional)
# ═══════════════════════════════════════════════════════════════════════════════

# Bot token from the Discord Developer Portal
DISCORD_TOKEN=

# Application/Client ID from the Discord Developer Portal
DISCORD_CLIENT_ID=

# The Discord server (guild) ID to register commands for during development
DISCORD_GUILD_ID=

# Role IDs from your Discord server — used by the bot to assign roles
DISCORD_ROLE_ADMIN=
DISCORD_ROLE_MEMBER=
DISCORD_ROLE_CONTRIBUTOR=

# Optional: Client Secret for OAuth2 flows (e.g., if adding login functionality)
# DISCORD_CLIENT_SECRET=

# ═══════════════════════════════════════════════════════════════════════════════
# BLOCKCHAIN INDEXER (access-api)
# ═══════════════════════════════════════════════════════════════════════════════

# EVM RPC URL
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your-api-key

# Membership Contract Address
MEMBERSHIP_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Confirmation depth for reorg safety (number of blocks)
INDEXER_CONFIRMATION_DEPTH=10

# Starting block for the indexer
INDEXER_START_BLOCK=0
